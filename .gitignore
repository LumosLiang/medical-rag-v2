# Terraform:状态里有存储账户密钥,变量文件里有账号相关的值,都不进仓库
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan
crash.log
crash.*.log

# 本地配置、密钥、只在本机用的检查规则
.env
.env.*
*.pem
*.p8
.harness/local/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
build/
dist/

# 只在本机用的东西:实验脚本、辅助工具、语料数据。scripts/ 里只有 CI 要跑的提交前检查进仓库。
spike/
data/
scripts/*
!scripts/check_forbidden.sh

# macOS
.DS_Store

# IDE 在仓库里生成的本地文件(计划等)
.snowflake/
